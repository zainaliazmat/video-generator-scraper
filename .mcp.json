{
  "mcpServers": {
    "vidiq": {
      "type": "http",
      "url": "https://mcp.vidiq.com/mcp?src=claude",
      "headers": {
        "Authorization": "Bearer ${VIDIQ_API_KEY}"
      }
    },
    "browseract": {
      "command": "npx",
      "args": [
        "-y",
        "browseract-mcp"
      ],
      "env": {
        "BROWSERACT_API_KEY": "<YOUR_BROWSERACT_API_KEY>"
      }
    }
  }
}
